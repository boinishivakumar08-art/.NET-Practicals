@model Practical6.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-4">

    <h1 class="text-center mb-4">Add New Product</h1>

    <form asp-controller="Product"
          asp-action="Create"
          method="post">

        <div class="mb-3">

            <label asp-for="Name"
                   class="form-label">
                Product Name
            </label>

            <input asp-for="Name"
                   class="form-control"
                   placeholder="Enter product name" />

        </div>

        <div class="mb-3">

            <label asp-for="Description"
                   class="form-label">
                Description
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      placeholder="Enter product description">
            </textarea>

        </div>

        <div class="mb-3">

            <label asp-for="Category"
                   class="form-label">
                Category
            </label>

            <input asp-for="Category"
                   class="form-control"
                   placeholder="Enter category" />

        </div>

        <div class="mb-3">

            <label asp-for="Price"
                   class="form-label">
                Price
            </label>

            <input asp-for="Price"
                   class="form-control"
                   type="number"
                   placeholder="Enter price" />

        </div>

        <button type="submit"
                class="btn btn-success">
            Add Product
        </button>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>